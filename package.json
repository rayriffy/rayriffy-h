{
  "name": "riffyh",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client/",
    "example/",
    "server/",
    "adapter/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.1.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "turbo": "2.10.5",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint",
    "!(*.lock)": "bun run fmt"
  },
  "packageManager": "bun@1.3.11"
}
