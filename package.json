{
  "name": "riffyh",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client/",
    "example/",
    "server/",
    "adapter/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint",
    "!(*.lock)": "bun run fmt"
  },
  "packageManager": "bun@1.4.4"
}
